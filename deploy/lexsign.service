[Unit]
Description=LexSign Court Signage API
After=network-online.target mongod.service
Wants=network-online.target

[Service]
User=lexsign
Group=lexsign
WorkingDirectory=/home/lexsign/app
EnvironmentFile=/etc/lexsign.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/lexsign/app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
